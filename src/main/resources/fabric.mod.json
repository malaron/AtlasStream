{
	"schemaVersion": 1,
	"id": "atlasstream",
	"version": "${version}",
	"name": "AtlasStream",
	"description": "Scalable texture-atlas streaming for oversized Minecraft resource packs with Sodium and Iris/PBR support.",
	"license": "All-Rights-Reserved",
	"icon": "assets/atlasstream/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.malaron.atlasstream.AtlasStream"
		],
		"client": [
			"com.malaron.atlasstream.client.AtlasStreamClient"
		],
		"modmenu": [
			"com.malaron.atlasstream.client.config.AtlasStreamModMenu"
		]
	},
	"mixins": [
		{
			"config": "atlasstream.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*",
		"yet_another_config_lib_v3": ">=3.9.7"
	}
}