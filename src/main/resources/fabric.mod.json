{
	"schemaVersion": 1,
	"id": "loads-of-lods",
	"version": "${version}",
	"name": "Loads of Lods",
	"description": "A client-side texture LOD prototype for large resource packs.",
	"license": "CC0-1.0",
	"icon": "assets/loads-of-lods/icon.png",
	"environment": "*",
